# Supabase — maak een gratis project aan op https://supabase.com
# Kies bij het aanmaken een EU-regio (bijv. Frankfurt) i.v.m. AVG / medische data + BSN.
# Deze twee waarden vind je in je Supabase-project onder: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://JOUW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-public-key

# De site-URL waarop de app draait (voor de inloglink in de e-mail).
# Lokaal: http://localhost:3000  — In productie: je echte domein.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
