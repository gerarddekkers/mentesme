# Backend (apps/api) — AWS eu-west-1 (Ierland)

# MySQL (RDS/Aurora). Formaat: mysql://gebruiker:wachtwoord@host:3306/zorgdossier
DATABASE_URL=mysql://app:CHANGE_ME@zorgdossier.xxxxx.eu-west-1.rds.amazonaws.com:3306/zorgdossier
# Zet op "true" om TLS uit te zetten voor lokaal testen (niet in productie).
DB_SSL_DISABLE=false

# Auth: mentesme-standaard (metro-auth). Basis-URL (incl. /rest) van de
# metro-backend waartegen we inloggen en tokens valideren.
#   login:     POST {METRO_BASE_URL}/user/login   body {"id": <email>, "password": ...}
#   valideren: GET  {METRO_BASE_URL}/user          header metro-auth: <token>
# Test: https://test.mentes.me/rest — Prod: https://mijn.metro.mentes.me/rest
METRO_BASE_URL=https://mijn.metro.mentes.me/rest

# Toegestane frontend-origin(s), komma-gescheiden.
WEB_ORIGIN=http://localhost:5173,https://zorgdossier.mentes.me

PORT=4000
